NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production on Vercel: set this to https://hkstudya.vercel.app (or your domain).
# If it is left as localhost, share / unlisted / class links fall back to the Vercel host.

# Shown on /privacy, /terms, /cookies (Hong Kong PDPO contact)
# NEXT_PUBLIC_LEGAL_EMAIL=privacy@your-domain.com
# NEXT_PUBLIC_LEGAL_OPERATOR=Your name or organisation
# NEXT_PUBLIC_LEGAL_JURISDICTION=Hong Kong

# Clerk — Development instance (pk_test_ / sk_test_)
# Local and *.vercel.app can share these until you have a custom domain.
# Then switch Vercel to a Production instance (pk_live_ / sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/decks
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/decks

# Optional: this email is treated as admin after Clerk sign-in
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Vercel: use Supabase Transaction pooler (port 6543) and add ?pgbouncer=true
DATABASE_URL=

# Required for AI generation and Play typed-answer grading (OpenRouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# LLM_DEFAULT_PROVIDER=openrouter

# Optional local Gemma (localhost only). If set, generation tries Ollama first, then OpenRouter.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
