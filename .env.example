NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production on Vercel: https://your-domain.com (or https://your-app.vercel.app)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Shown on /privacy, /terms, /cookies (Hong Kong PDPO contact)
# NEXT_PUBLIC_LEGAL_EMAIL=privacy@your-domain.com
# NEXT_PUBLIC_LEGAL_OPERATOR=Your name or organisation
# NEXT_PUBLIC_LEGAL_JURISDICTION=Hong Kong

# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: this email is treated as admin after Clerk sign-in
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Vercel: use Supabase Transaction pooler (port 6543) and add ?pgbouncer=true
DATABASE_URL=

# Required for AI generation and Play typed-answer grading (OpenRouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# LLM_DEFAULT_PROVIDER=openrouter
