NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production on Vercel: set both to https://your-domain.com (or https://your-app.vercel.app)
# BETTER_AUTH_URL=https://your-domain.com
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Shown on /privacy, /terms, /cookies (Hong Kong PDPO contact)
# NEXT_PUBLIC_LEGAL_EMAIL=privacy@your-domain.com
# NEXT_PUBLIC_LEGAL_OPERATOR=Your name or organisation
# NEXT_PUBLIC_LEGAL_JURISDICTION=Hong Kong

# Better Auth — openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First admin (created by npm run db:migrate / db:bootstrap-admin)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Vercel: use Supabase Transaction pooler (port 6543) and add ?pgbouncer=true
DATABASE_URL=

# Optional — Clerk (social / hosted sign-in, works alongside Better Auth)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# Required for AI generation (OpenRouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# LLM_DEFAULT_PROVIDER=openrouter
