{
  "name": "hk-study-a-apk",
  "private": true,
  "description": "Android WebView wrapper for HK Study A. The Next.js web app stays at the repo root.",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "add:android": "cap add android",
    "icons": "node scripts/generate-icons.mjs",
    "debug": "cd android && JAVA_HOME=\"${HOME}/Library/Java/JavaVirtualMachines/jbr-21.0.11/Contents/Home\" ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk \"../../HK-Study-A-debug.apk\""
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4"
  }
}
